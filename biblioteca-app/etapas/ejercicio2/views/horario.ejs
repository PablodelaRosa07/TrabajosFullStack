<%- include('partials/cabecera') %>
  <h1><%= titulo %></h1>
  <p>Estos son los días y horas de apertura de la biblioteca:</p>
  <table>
    <thead>
      <tr>
        <th>Día</th>
        <th>Horas</th>
      </tr>
    </thead>
    <tbody>
      <% horario.forEach(fila => { %>
        <tr>
          <td><%= fila.dia %></td>
          <td><%= fila.horas %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<%- include('partials/pie') %>
